<Project>
  <!-- Build output lives outside the repo: the repo is synced to Google Drive, and every rebuild
       would otherwise re-sync the output files. -->
  <PropertyGroup>
    <BuildRoot>$(LOCALAPPDATA)\build\OfficeFileVersionUpdater\</BuildRoot>
    <BaseIntermediateOutputPath>$(BuildRoot)obj\</BaseIntermediateOutputPath>
    <BaseOutputPath>$(BuildRoot)bin\</BaseOutputPath>
    <MSBuildProjectExtensionsPath>$(BaseIntermediateOutputPath)</MSBuildProjectExtensionsPath>
  </PropertyGroup>
</Project>
